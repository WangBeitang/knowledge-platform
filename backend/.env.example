# ============================================================
# 后端运行配置模板（复制为 backend/.env 并填入真实值；.env 不提交 Git）
# 生产环境强随机值生成（部署机执行）：
#   SECRET_KEY=$(openssl rand -hex 32)
#   SERVICE_API_KEY=$(openssl rand -hex 24)
#   DB_PASSWORD / REDIS_PASSWORD 见 deploy/.env.example
# ============================================================

# ========== 平台自身 ==========
# 生产必须为 production（禁止默认回环 DB 地址）
APP_ENV=development
# JWT 签名密钥（生产必须更换为强随机值）
SECRET_KEY=change-me-strong-random-value
JWT_EXPIRES_SECONDS=21600
# 外部服务密钥（阶段 6 使用）
SERVICE_API_KEY=change-me-service-api-key
# CORS 允许的前端来源（逗号分隔）；生产必须为实际平台前端来源，禁止配置 *
CORS_ORIGINS=https://your-domain.example.com

# ========== MySQL（平台独立库；生产使用独立应用账号，禁止 root）==========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=kp_app
DB_PASSWORD=change-me-mysql-app-password
DB_NAME=knowledge_platform

# ========== Redis ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0

# ========== 原 RAG（部署时为 backend 容器实际可达的内部地址）==========
# Docker Compose 部署：RAG 在宿主机进程运行时用 host.docker.internal
# （compose 已配置 extra_hosts: host.docker.internal:host-gateway），
# 禁止直接使用 127.0.0.1（容器内 127.0.0.1 指容器自身）。
# RAG 若跑在另一个容器/内网主机，则填其 Docker 网络名或内网 IP。
RAG_QUERY_BASE_URL=http://host.docker.internal:8001
RAG_IMPORT_BASE_URL=http://host.docker.internal:8002
RAG_SERVICE_USER_ADMIN=svc_knowledge_admin
RAG_SERVICE_USER_EMPLOYEE=svc_knowledge_employee
RAG_SERVICE_USER_EXTERNAL=svc_knowledge_external

# ========== 三档 Dataset ==========
# 原 RAG Dataset 的 dataset_id 是客户端可显式指定的稳定 ID（1~120 字符，仅字母数字_-），
# 非展示名。以下三档值由平台 env 指定，bootstrap 时先查后建（幂等）。
RAG_EXTERNAL_DATASET_ID=securities_external_public
RAG_INTERNAL_DATASET_ID=securities_internal_shared
RAG_ADMIN_DATASET_ID=securities_admin_private

# ========== 初始管理员（幂等初始化命令使用，首次登录后应重置）==========
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=change-me-init-password

# ========== 可选演示数据（python -m app.scripts.seed_demo，不配置则跳过）==========
DEMO_EMPLOYEE_USERNAME=
DEMO_EMPLOYEE_PASSWORD=
