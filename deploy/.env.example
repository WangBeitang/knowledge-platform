# ============================================================
# 目标云服务器部署环境变量模板（复制为 deploy/.env 并填入真实值）
# 禁止继续使用 change-me-* 示例值；部署机生成真实强随机值：
#   openssl rand -hex 32   # SECRET_KEY
#   openssl rand -hex 24   # SERVICE_API_KEY / MYSQL_PASSWORD / REDIS_PASSWORD
# 本文件与 deploy/.env 均不提交 Git。
# ============================================================

# ---- MySQL（root 仅用于容器初始化/运维，不进入 backend 运行配置）----
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password
# 平台应用账号（backend 使用；禁止 root）
MYSQL_APP_USER=kp_app
MYSQL_APP_PASSWORD=change-me-mysql-app-password

# ---- Redis（backend 使用）----
REDIS_PASSWORD=change-me-redis-password

# ---- 原 RAG（宿主进程运行时，backend 容器内用 host.docker.internal 访问）----
# RAG_QUERY_PORT / RAG_IMPORT_PORT 为原 RAG 在宿主机监听的实际端口
RAG_QUERY_PORT=8001
RAG_IMPORT_PORT=8002
